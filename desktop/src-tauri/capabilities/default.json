{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "allow-get-engine-url",
      "description": "前端获取本地引擎 URL",
      "commands": {
        "allow": ["get_engine_url"]
      }
    }
  ]
}
